Algoritmo PruebaArreglos
    Definir n Como Entero

    n = 5

    Dimensionar numeros[n + 5]

    numeros[0] = 10
    numeros[1] = 20
    numeros[2] = 30
    numeros[3] = 40
    numeros[4] = 50

    Escribir "Numeros:"
	Escribir numeros[0]
	Escribir numeros[1]
	Escribir numeros[2]
	Escribir numeros[3]
	Escribir numeros[4]

	Dimensionar matriz[3, 4]

	matriz[0][0] = 1.5
	matriz[0][1] = 2.5
	matriz[1][0] = 3.5
	matriz[1][1] = 4.5

	Escribir "Matriz:"
	Escribir matriz[0][0]
	Escribir matriz[1][1]
FinAlgoritmo
