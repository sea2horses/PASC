MainFunction 'Dona3D' {
decl A, B, i, j as type<Real>
decl c, d, e, f, g, h as type<Real>
decl DD, l, m, n, t as type<Real>
decl x, yy, oo, NN as type<Entero>
Dimension bb [1760.0]
Dimension z [1760.0]
A = 0.0
B = 0.0
While 'true' {
For i = 0.0 -> 1759.0 {
bb[i] = " "
z[i] = 0.0
}
j = 0.0
While '(j < 6.28)' {
i = 0.0
While '(i < 6.28)' {
c = Call 'Sen': (
i)
d = Call 'Cos': (
j)
e = Call 'Sen': (
A)
f = Call 'Sen': (
j)
g = Call 'Cos': (
A)
h = (d + 2.0)
DD = (1.0 / ((((c * h) * e) + (f * g)) + 5.0))
l = Call 'Cos': (
i)
m = Call 'Cos': (
B)
n = Call 'Sen': (
B)
t = (((c * h) * g) - (f * e))
x = Call 'Trunc': (
(40.0 + ((30.0 * DD) * (((l * h) * m) - (t * n)))))
yy = Call 'Trunc': (
(12.0 + ((15.0 * DD) * (((l * h) * n) + (t * m)))))
oo = (x + (80.0 * yy))
NN = Call 'Trunc': (
(8.0 * ((((((f * e) - ((c * d) * g)) * m) - ((c * d) * e)) - (f * g)) - ((l * d) * n))))
If '((((yy >= 0.0) && (yy < 22.0)) && (x >= 0.0)) && (x < 80.0))' {
If '(DD > z[oo])' {
z[oo] = DD
If '(NN < 0.0)' {
NN = 0.0
} 
If '(NN > 11.0)' {
NN = 11.0
} 
Switch 'NN': {
Case '0.0': {
bb[oo] = "."
}
Case '1.0': {
bb[oo] = ","
}
Case '2.0': {
bb[oo] = "-"
}
Case '3.0': {
bb[oo] = "~"
}
Case '4.0': {
bb[oo] = ":"
}
Case '5.0': {
bb[oo] = ";"
}
Case '6.0': {
bb[oo] = "="
}
Case '7.0': {
bb[oo] = "!"
}
Case '8.0': {
bb[oo] = "*"
}
Case '9.0': {
bb[oo] = "#"
}
Case '10.0': {
bb[oo] = "$"
}
Case '11.0': {
bb[oo] = "@"
}
}
} 
} 
i = (i + 0.2)
}
j = (j + 0.7)
}
clear screen
For yy = 0.0 -> 21.0 {
For x = 0.0 -> 79.0 {
Write [bb[(x + (80.0 * yy))]]
}
Write [""]
}
A = (A + 0.4)
B = (B + 0.2)
}
}
